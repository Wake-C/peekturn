<resources>
    <style name="Theme.Peekturn.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAFA</item>
        <!-- Before API 27 the theme cannot request dark navigation icons; keep this bar dark. -->
        <item name="android:navigationBarColor">#171E23</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:colorAccent">#3267C8</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Peekturn" parent="Theme.Peekturn.Base" />
    <color name="launcher_background">#FFD84C</color>
</resources>
