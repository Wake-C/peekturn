<?xml version="1.0" encoding="utf-8"?>
<!-- Languages offered by the in-app picker and by Android's per-app language settings. The default
     res/values strings are English, so that is the fallback language. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh" />
</locale-config>
